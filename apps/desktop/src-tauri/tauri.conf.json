{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ReChimera",
  "version": "0.6.0",
  "identifier": "dev.rechimera.desktop",
  "build": {
    "beforeDevCommand": "bun run dev",
    "beforeBuildCommand": "bun run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ReChimera",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "maximized": true,
        "center": true,
        "decorations": false,
        "transparent": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' ipc: tauri: http://ipc.localhost http://tauri.localhost",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "connect-src": "'self' ipc: tauri: http://ipc.localhost http://tauri.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'"
      },
      "devCsp": {
        "default-src": "'self' ipc: tauri: http://ipc.localhost http://tauri.localhost",
        "img-src": "'self' blob: data:",
        "media-src": "'self' blob: data:",
        "connect-src": "'self' ipc: tauri: http://ipc.localhost http://tauri.localhost ws://localhost:1420 http://localhost:1420 blob: data:",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'wasm-unsafe-eval'",
        "font-src": "'self' data:",
        "worker-src": "'self' blob:",
        "frame-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'self'"
      }
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": [
        "https://github.com/Mrroboto9819/ReChimera/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDY0RjU4NTdCQTJGQTQyM0YKUldRL1F2cWllNFgxWkw2aHE4aE8wZklXV1BrTGZ2bHpNVnRHaC9sR1lHWlhWb0VIMTNIQXRzNnIK"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper",
        "silent": true
      },
      "nsis": {
        "installMode": "both"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
